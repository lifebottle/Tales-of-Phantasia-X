;DISPLAY RESOLUTION CODES
;Modifies the resolution at what 2D Maps are displayed
;To create custom resolutions modify the 4 initial lines
;
;0x20125784 0x####XXXX
;0x20125788 0x####YYYY
;0x20125794 0x####WWWW
;0x201257AC 0x####HHHH
;
;XXXX - X pos
;YYYY - Y pos
;WWWW - Width
;HHHH - Height
;
;Rest of the lines clean the framebuffer on the black bars

_C0 TOPX Resolution Modifier
_M 0xCF000000 0x00000005

;PSX native resolution
;Has horizontal black bars
_C0 8:7 style Scaling Pixel Perfect
_L 0x20125784 0x34040048
_L 0x20125788 0x34050010
_L 0x20125794 0x34060150
_L 0x201257AC 0x340700F0
_L 0x2012577C 0x10000024
