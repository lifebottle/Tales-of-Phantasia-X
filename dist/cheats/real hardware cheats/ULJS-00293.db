_C0 --------------------------------
_M 0xCF000001 0x00000000

;ITEM CODES
;
;Be careful to not overwrite items or duplicate them in different slots
;
;If you want to change the slot to 1 (not recommended):
;Change the 2nd line address 0x108898E6 -> 0x108895F0
;If you overwrite an item you'll need cheats to be able to see it again!!
;If you duplicate an item on different slots, try to equip and unequip it or just delete it
;
;If you want to change the quantity (x1):
;Change the 1st line value from anything between 1 to 15 (or 20 on NG+)
;(0x00000001 to 0x00000020)
;
;If you already have the item and only want to edit its quantity:
;Delete the second line entirely
;This will avoid item duplication on different slots

_C0 TOPX Item Slot 380 Modifier
_M 0xCF000000 0x00000192     

